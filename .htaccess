<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Redirect root ke login
    RewriteRule ^$ auth/login.php [L]
    
    # Redirect /login ke auth/login.php
    RewriteRule ^login$ auth/login.php [L]
    RewriteRule ^login/$ auth/login.php [L]
    
    # Redirect /home ke user/index.php
    RewriteRule ^home$ user/index.php [L]
    
    # Redirect /admin ke admin/index.php
    RewriteRule ^admin$ admin/index.php [L]
    
    # Jika file/direktori tidak ditemukan, redirect ke login
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ auth/login.php [QSA,L]
</IfModule>

# Izinkan akses ke assets
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$">
        Header set Cache-Control "max-age=2592000, public"
    </FilesMatch>
</IfModule>

# Cegah akses ke file sensitif
<FilesMatch "\.(json|env|config|log)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Error documents
ErrorDocument 404 /izin/auth/login.php
ErrorDocument 403 /izin/auth/login.php