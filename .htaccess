# ============================================
# .htaccess untuk doret.id - Manajemen Cuti
# ============================================

# Enable mod_rewrite
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Jika file/direktori tidak ditemukan, redirect ke login
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ login.php [QSA,L]
</IfModule>

# Security: Cegah akses ke file sensitif
<FilesMatch "\.(json|env|config|log|ini|sql|bak)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Security: Cegah directory listing
Options -Indexes

# Set default charset
AddDefaultCharset UTF-8

# Error documents
ErrorDocument 404 /izin/login.php
ErrorDocument 403 /izin/login.php

# Cache static assets
<FilesMatch "\.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$">
    Header set Cache-Control "max-age=2592000, public"
</FilesMatch>